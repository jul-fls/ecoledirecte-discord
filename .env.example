# Obligatoire. Garder les guillemets simples (notamment pour # et $).
ECOLEDIRECTE_IDENTIFIANT='votre.identifiant'
ECOLEDIRECTE_MDP='votre.mot.de.passe'
DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/123456789/remplacer-le-token'

# Profil demandé : A = personnel, P = enseignant. Route de messagerie adaptée au profil.
ECOLEDIRECTE_PROFILE=A
# Optionnel : ID ou UID du compte de connexion si plusieurs comptes existent.
ECOLEDIRECTE_ACCOUNT_ID=
ECOLEDIRECTE_API_BASE_URL=https://api.ecoledirecte.com/v3
ECOLEDIRECTE_APIP_BASE_URL=https://apip.ecoledirecte.com/v3
ECOLEDIRECTE_API_VERSION=4.98.0
# Facultatif : année de messagerie AAAA-AAAA. Vide = année courante choisie par ED.
ECOLEDIRECTE_MESSAGES_YEAR=
# Fuseau des dates ED sans offset ; indépendant de l'heure du conteneur.
ECOLEDIRECTE_TIMEZONE=Europe/Paris

POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
# Limites de téléchargement en mémoire. Augmenter uniquement si Discord accepte ces tailles.
ATTACHMENT_MAX_MB=10
ATTACHMENTS_TOTAL_MAX_MB=64
DISCORD_USERNAME=EcoleDirecte
# ID optionnel d'un fil Discord existant (obligatoire pour un salon forum/media).
DISCORD_THREAD_ID=
